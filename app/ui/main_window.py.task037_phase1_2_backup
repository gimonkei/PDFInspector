    def on_annotation_clicked(self, page_index, page_point):
        if not self.document.has_document():
            return

        mode = self.view.annotation_mode

        if mode == "check":
            self.view.add_check_overlay(page_index, page_point)
            return

        if mode == "comment":
            defaults = deepcopy(
                self._annotation_defaults.get(
                    "text",
                    {},
                )
            )
            dialog = CommentCreateDialog(
                self,
                defaults,
            )
            if (
                dialog.exec()
                != QDialog.DialogCode.Accepted
            ):
                return

            values = dialog.values()
            text = values.pop("text")

            self._remember_annotation_defaults(
                "text",
                values,
            )
            self.view.add_text_overlay(
                page_index,
                page_point,
                text,
            )
            return

        if mode == "date_stamp":
            self.view.add_date_stamp_overlay(
                page_index,
                page_point,
                self.current_date_stamp_settings(),
            )
            return


    def update_selected_date_stamp(self):
        memory_values = {
            "top": self.stamp_top_edit.text().strip(),
            "bottom": self.stamp_bottom_edit.text().strip(),
            "color": self.stamp_color_combo.currentData(),
            "size": float(self.stamp_size_spin.value()),
            "line_width": float(self.stamp_line_spin.value()),
        }
        self._remember_annotation_defaults(
            "date_stamp",
            memory_values,
        )

        preview_settings = dict(memory_values)
        preview_settings["date"] = (
            self.stamp_date_edit.text().strip()
            or date.today().strftime("'%y/%m/%d")
        )
        self.view.set_date_stamp_preview_settings(preview_settings)

        item = self.selected_date_stamp_item
        if item is None or item.scene() is None:
            return

        self.view.update_annotation_record(
            item,
            {
                **memory_values,
                "date": self.stamp_date_edit.text().strip(),
            },
            merge_property_edits=True,
        )



    def focus_annotation_from_list(
        self,
        annotation_id,
        page_index,
    ):
        if not self.document.has_document():
            return

        page_index = min(
            max(int(page_index), 0),
            max(self.document.page_count - 1, 0),
        )

        self.current_page = page_index
        self.view.scroll_to_page(page_index)
        self.update_toolbar()

        if hasattr(self, "page_thumbnail_panel"):
            self.page_thumbnail_panel.select_page(
                page_index
            )

        # In single-page mode scroll_to_page rebuilds the scene. Defer the
        # selection until the new page and its annotation items exist.
        QTimer.singleShot(
            0,
            lambda annotation_id=str(annotation_id): (
                self._complete_annotation_list_focus(
                    annotation_id
                )
            ),
        )

    def _complete_annotation_list_focus(
        self,
        annotation_id,
    ):
        if not self.document.has_document():
            return

        focused = self.view.focus_annotation_by_id(
            annotation_id
        )
        if not focused:
            # A render/layout event can occasionally still be pending.
            QTimer.singleShot(
                30,
                lambda annotation_id=str(annotation_id): (
                    self.view.focus_annotation_by_id(
                        annotation_id
                    )
                ),
            )

        self.annotation_layer_toggle.setChecked(True)
        self.annotation_layer_dock.raise_()

    def on_annotation_selected(self, item):
        if (
            item is not None
            and hasattr(self, "annotation_layer_panel")
        ):
            self.annotation_layer_panel.select_annotation_id(
                getattr(item, "record", {}).get("id")
            )

        selected_count = 0
        try:
            selected_count = len(
                self.view._selected_annotation_items()
            )
        except RuntimeError:
            selected_count = 0

        if hasattr(self, "annotation_properties_panel"):
            if item is None:
                self.annotation_properties_panel.clear()
            elif selected_count <= 1:
                self.annotation_properties_panel.set_item(item)
                self.annotation_properties_stack.setCurrentWidget(
                    self.annotation_properties_panel
                )
                self.annotation_layer_toggle.setChecked(True)
                self.annotation_layer_dock.raise_()
            else:
                # annotation_selected identifies the active object inside a
                # multi-selection. Do not let it replace the multi-edit panel.
                self.multi_annotation_properties_panel.set_selection_count(
                    selected_count
                )
                self.annotation_properties_stack.setCurrentWidget(
                    self.multi_annotation_properties_panel
                )
                self.annotation_layer_toggle.setChecked(True)
                self.annotation_layer_dock.raise_()

        if getattr(item, "record", {}).get("type") != "date_stamp":
            self.selected_date_stamp_item = None
            return

        self.selected_date_stamp_item = item
        record = item.record
        widgets = [
            self.stamp_top_edit,
            self.stamp_date_edit,
            self.stamp_bottom_edit,
            self.stamp_color_combo,
            self.stamp_size_spin,
            self.stamp_line_spin,
        ]
        for widget in widgets:
            widget.blockSignals(True)

        self.stamp_top_edit.setText(record.get("top", ""))
        self.stamp_date_edit.setText(record.get("date", ""))
        self.stamp_bottom_edit.setText(record.get("bottom", ""))
        color_index = self.stamp_color_combo.findData(
            record.get("color", "black")
        )
        self.stamp_color_combo.setCurrentIndex(
            max(0, color_index)
        )
        self.stamp_size_spin.setValue(
            round(float(record.get("size", 72.0)))
        )
        self.stamp_line_spin.setValue(
            float(record.get("line_width", 1.5))
        )

        for widget in widgets:
            widget.blockSignals(False)


    def on_annotation_edit_requested(self, item):
        record = getattr(item, "record", None)
        if not record:
            return

        selected_count = 0
        try:
            selected_count = len(
                self.view._selected_annotation_items()
            )
        except RuntimeError:
            selected_count = 0

        if selected_count > 1:
            self.multi_annotation_properties_panel.set_selection_count(
                selected_count
            )
            self.annotation_properties_stack.setCurrentWidget(
                self.multi_annotation_properties_panel
            )
        else:
            self.annotation_properties_panel.set_item(item)
            self.annotation_properties_stack.setCurrentWidget(
                self.annotation_properties_panel
            )

        if hasattr(self, "annotation_properties_toggle"):
            self.annotation_properties_toggle.setChecked(True)
        elif hasattr(self, "annotation_properties_dock"):
            self.annotation_properties_dock.show()
            self.annotation_properties_dock.raise_()
        elif hasattr(self, "annotation_layer_dock"):
            self.annotation_layer_dock.show()
            self.annotation_layer_dock.raise_()
        self.annotation_properties_dock.raise_()


    def _commit_pending_annotations(self):
        annotations = self.view.export_annotations()
        if not annotations:
            return False

        for annotation in annotations:
            if annotation["type"] == "check":
                self.document.add_checkmark(
                    annotation["page_index"],
                    annotation["x"],
                    annotation["y"],
                    annotation.get("size", 15.0),
                    annotation.get("color", "#dc0000"),
                    annotation.get("line_width", 2.2),
                )
            elif annotation["type"] == "text":
                self.document.add_freetext_comment(
                    annotation["page_index"],
                    annotation["x"],
                    annotation["y"],
                    annotation["text"],
                    annotation.get("font_size", 11.0),
                    annotation.get(
                        "font_family",
                        "Meiryo",
                    ),
                    annotation.get(
                        "text_color",
                        "#dc0000",
                    ),
                    annotation.get(
                        "underline",
                        False,
                    ),
                    annotation.get(
                        "border_enabled",
                        False,
                    ),
                    annotation.get(
                        "border_color",
                        "#dc0000",
                    ),
                    annotation.get(
                        "border_width",
                        1.5,
                    ),
                    annotation.get(
                        "border_padding_x",
                        2.0,
                    ),
                    annotation.get(
                        "border_padding_y",
                        1.0,
                    ),
                )
            elif annotation["type"] == "date_stamp":
                self.document.add_date_stamp(
                    annotation["page_index"],
                    annotation["x"],
                    annotation["y"],
                    annotation.get("top", ""),
                    annotation.get("date", ""),
                    annotation.get("bottom", ""),
                    annotation.get("color", "black"),
                    annotation.get("size", 72.0),
                    annotation.get("line_width", 1.5),
                )
            elif annotation["type"] == "freehand":
                self.document.add_freehand(
                    annotation["page_index"],
                    annotation["x"],
                    annotation["y"],
                    annotation.get("points", []),
                    annotation.get("color", "#dc0000"),
                    annotation.get("line_width", 2.0),
                    annotation.get("opacity", 1.0),
                )
            elif annotation["type"] == "arrow":
                self.document.add_arrow(
                    annotation["page_index"],
                    annotation["x"],
                    annotation["y"],
                    annotation["x"] + annotation.get("dx", 80.0),
                    annotation["y"] + annotation.get("dy", 0.0),
                    annotation.get("color", "red"),
                    annotation.get("line_width", 2.0),
                )
            elif annotation["type"] in {"rectangle", "ellipse"}:
                self.document.add_shape(
                    annotation["type"],
                    annotation["page_index"],
                    annotation["x"],
                    annotation["y"],
                    annotation.get("width", 80.0),
                    annotation.get("height", 50.0),
                    annotation.get("color", "red"),
                    annotation.get("line_width", 2.0),
                    annotation.get("text", ""),
                    annotation.get("font_size", 11.0),
                    annotation.get("text_color", "#000000"),
                    annotation.get("fill_enabled", False),
                    annotation.get("fill_opacity", 0.25),
                    annotation.get("fill_color", "#ffff00"),
                )
            elif annotation["type"] == "image":
                page_index = int(
                    annotation.get("page_index", -1)
                )
                if (
                    self.document.doc is not None
                    and 0 <= page_index < len(self.document.doc)
                ):
                    draw_image_annotation(
                        self.document.doc[page_index],
                        annotation,
                    )
            elif annotation["type"] in {"stamp", "callout"}:
                commit_annotation_to_document(
                    self.document,
                    annotation,
                )
            elif annotation["type"] == "balloon":
                page_index = int(
                    annotation.get("page_index", -1)
                )
                if (
                    self.document.doc is not None
                    and 0 <= page_index < len(self.document.doc)
                ):
                    draw_balloon_annotation(
                        self.document.doc[page_index],
                        annotation,
                    )
            elif annotation["type"] == "cloud":
                self.document.add_cloud(
                    annotation["page_index"],
                    annotation["x"],
                    annotation["y"],
                    annotation.get("width", 80.0),
                    annotation.get("height", 50.0),
                    annotation.get("color", "red"),
                    annotation.get("line_width", 2.0),
                    annotation.get("cloud_radius", 8.0),
                    annotation.get("text", ""),
                    annotation.get("font_size", 11.0),
                    annotation.get("text_color", "#000000"),
                    annotation.get("fill_enabled", False),
                    annotation.get("fill_opacity", 0.25),
                    annotation.get("fill_color", "#ffff00"),
                )

        self.view.clear_pending_annotations()
        self.render_pipeline.invalidate()
        self.render_manager.clear()
        self.render_manager.prepare_document(self.document)
        self.view.clear_rendered_tiles()
        self.schedule_visible_tile_render()
        return True

