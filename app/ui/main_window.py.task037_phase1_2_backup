            ),
        }



class AnnotationPropertiesPanel(QWidget):
    """Right-side editor for the currently active annotation."""

    TYPE_NAMES = {
        "check": "チェックマーク",
        "text": "コメント",
        "date_stamp": "デート印",
        "arrow": "矢印",
        "rectangle": "矩形",
        "ellipse": "円・楕円",
        "cloud": "クラウド",
        "freehand": "手書き",
        "stamp": "スタンプ",
        "callout": "吹き出し",
    }

    def __init__(self, main_window):
        super().__init__(main_window)
        self.main_window = main_window

        # The dock width is user-adjustable. Keep only a practical minimum
        # so controls do not become unusably narrow.
        self.setMinimumWidth(230)
        self.setSizePolicy(
            QSizePolicy.Policy.Expanding,
            QSizePolicy.Policy.Expanding,
        )
        self.item = None
        self.record = None
        self._loading = False
        self._color_values = {}

        self.root_layout = QVBoxLayout(self)
        self.title_label = QLabel("注釈を選択してください", self)
        self.title_label.setStyleSheet(
            "font-weight: bold; padding: 4px;"
        )
        self.root_layout.addWidget(self.title_label)

        self.form_widget = QWidget(self)
        self.form_layout = QFormLayout(self.form_widget)
        self.root_layout.addWidget(self.form_widget)

        self._text_apply_timer = QTimer(self)
        self._text_apply_timer.setSingleShot(True)
        self._text_apply_timer.setInterval(450)
        self._text_apply_timer.timeout.connect(
            self.apply_changes
        )

        self._geometry_sync_timer = QTimer(self)
        self._geometry_sync_timer.setInterval(100)
        self._geometry_sync_timer.timeout.connect(
            self.sync_geometry_from_record
        )
        self._geometry_sync_timer.start()

        self.root_layout.addStretch(1)

    def clear(self):
        self.item = None
        self.record = None
        self.title_label.setText("注釈を選択してください")
        self._clear_form()
        self._text_apply_timer.stop()

    def _clear_form(self):
        while self.form_layout.rowCount() > 0:
            self.form_layout.removeRow(0)
        self._color_values = {}

    def set_item(self, item):
        if self.item is not None and not self._loading:
            self._text_apply_timer.stop()

        record = getattr(item, "record", None)
        if not record:
            self.clear()
            return

        self.item = item
        self.record = record
        self._loading = True
        self._clear_form()

        record_type = str(record.get("type", ""))
        self.title_label.setText(
            self.TYPE_NAMES.get(record_type, record_type)
        )

        self.type_label = QLabel(
            self.TYPE_NAMES.get(record_type, record_type),
            self,
        )
        self.form_layout.addRow("種類:", self.type_label)

        if record_type == "check":
            self._add_color("color", "色", record.get("color", "#dc0000"))
            self.size_spin = self._add_double(
                "サイズ",
                record.get("size", 15.0),
                6.0,
                200.0,
                1.0,
                " pt",
            )
            self.line_width_spin = self._add_double(
                "線幅",
                record.get("line_width", 2.2),
                0.5,
                10.0,
                0.5,
                " pt",
            )

        elif record_type in {"arrow", "freehand"}:
            self._add_color("color", "色", record.get("color", "#dc0000"))
            self.line_width_spin = self._add_double(
                "太さ",
                record.get("line_width", 2.0),
                0.5,
                10.0,
                0.5,
                " pt",
            )

        elif record_type in {"rectangle", "cloud"}:
            self.text_edit = QTextEdit(self)
            self.text_edit.setMaximumHeight(110)
            self.text_edit.setPlainText(str(record.get("text", "")))
            self.form_layout.addRow("文字:", self.text_edit)

            self._add_color(
                "text_color",
                "文字色",
                record.get("text_color", "#000000"),
            )
            self._add_color(
                "border_color",
                "枠線色",
                record.get("color", "#dc0000"),
            )
            self.line_width_spin = self._add_double(
                "枠線太さ",
                record.get("line_width", 2.0),
                0.5,
                10.0,
                0.5,
                " pt",
            )
            self.width_spin = self._add_double(
                "幅",
                record.get("width", 80.0),
                8.0,
                3000.0,
                1.0,
                " pt",
            )
            self.height_spin = self._add_double(
                "高さ",
                record.get("height", 50.0),
                8.0,
                3000.0,
                1.0,
                " pt",
            )

            self.fill_check = QCheckBox("塗りつぶす", self)
            self.fill_check.setChecked(
                bool(record.get("fill_enabled", False))
            )
            self.form_layout.addRow("背景:", self.fill_check)

            self._add_color(
                "fill_color",
                "塗りつぶし色",
                record.get("fill_color", "#ffff00"),
            )
            self.opacity_spin = self._add_double(
                "濃度",
                float(record.get("fill_opacity", 0.25)) * 100.0,
                0.0,
                100.0,
                5.0,
                " %",
            )

        elif record_type == "ellipse":
            self._add_color(
                "border_color",
                "枠線色",
                record.get("color", "#dc0000"),
            )
            self.line_width_spin = self._add_double(
                "枠線太さ",
                record.get("line_width", 2.0),
                0.5,
                10.0,
                0.5,
                " pt",
            )
            self.width_spin = self._add_double(
                "幅",
                record.get("width", 80.0),
                8.0,
                3000.0,
                1.0,
                " pt",
            )
            self.height_spin = self._add_double(
                "高さ",
                record.get("height", 50.0),
                8.0,
                3000.0,
                1.0,
                " pt",
            )

            self.fill_check = QCheckBox("塗りつぶす", self)
            self.fill_check.setChecked(
                bool(record.get("fill_enabled", False))
            )
            self.form_layout.addRow("背景:", self.fill_check)

            self._add_color(
                "fill_color",
                "塗りつぶし色",
                record.get("fill_color", "#ffff00"),
            )
