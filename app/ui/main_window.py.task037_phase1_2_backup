    def _template_file_path(self):
        base = Path(QStandardPaths.writableLocation(QStandardPaths.StandardLocation.AppConfigLocation))
        base.mkdir(parents=True, exist_ok=True)
        return base / "date_stamp_templates.json"

    def _load_date_stamp_templates(self):
        path = self._template_file_path()
        if not path.exists():
            return {}
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
            return data if isinstance(data, dict) else {}
        except (OSError, ValueError):
            return {}

    def _write_date_stamp_templates(self):
        path = self._template_file_path()
        path.write_text(
            json.dumps(self.date_stamp_templates, ensure_ascii=False, indent=2),
            encoding="utf-8",
        )

    def _refresh_template_combo(self, selected_name=None):
        combo = getattr(self, "stamp_template_combo", None)
        if combo is None:
            return
        combo.blockSignals(True)
        combo.clear()
        combo.addItem("新規作成", "")
        for name in sorted(self.date_stamp_templates):
            combo.addItem(name, name)
        if selected_name:
            index = combo.findData(selected_name)
            if index >= 0:
                combo.setCurrentIndex(index)
        combo.blockSignals(False)

    def on_date_stamp_template_selected(self, _index):
        name = self.stamp_template_combo.currentData()
        if not name:
            return
        settings = self.date_stamp_templates.get(name)
        if not settings:
            return
        widgets = [
            self.stamp_top_edit, self.stamp_bottom_edit, self.stamp_color_combo,
            self.stamp_size_spin, self.stamp_line_spin,
        ]
        for widget in widgets:
            widget.blockSignals(True)
        self.stamp_top_edit.setText(settings.get("top", ""))
        self.stamp_bottom_edit.setText(settings.get("bottom", ""))
        color_index = self.stamp_color_combo.findData(settings.get("color", "black"))
        self.stamp_color_combo.setCurrentIndex(max(0, color_index))
        self.stamp_size_spin.setValue(round(float(settings.get("size", 72.0))))
        self.stamp_line_spin.setValue(float(settings.get("line_width", 1.5)))
        self.stamp_date_edit.setText(date.today().strftime("'%y/%m/%d"))
        for widget in widgets:
            widget.blockSignals(False)
        self.update_selected_date_stamp()

    def save_date_stamp_template(self):
        current = self.stamp_template_combo.currentData()
        name, accepted = QInputDialog.getText(
            self, "テンプレート保存", "テンプレート名:", text=current or ""
        )
        name = name.strip()
        if not accepted or not name:
            return
        settings = self.current_date_stamp_settings()
        settings.pop("date", None)
        settings["use_today"] = True
        self.date_stamp_templates[name] = settings
        self._write_date_stamp_templates()
        self._refresh_template_combo(name)

    def delete_date_stamp_template(self):
        name = self.stamp_template_combo.currentData()
        if not name:
            return
        answer = QMessageBox.question(
            self, "テンプレート削除", f"「{name}」を削除しますか？"
        )
        if answer != QMessageBox.StandardButton.Yes:
            return
        self.date_stamp_templates.pop(name, None)
        self._write_date_stamp_templates()
        self._refresh_template_combo()

    def current_date_stamp_settings(self):
        today_text = date.today().strftime("'%y/%m/%d")
        self.stamp_date_edit.setText(today_text)

        settings = {
            "top": self.stamp_top_edit.text().strip(),
            "date": today_text,
            "bottom": self.stamp_bottom_edit.text().strip(),
            "color": self.stamp_color_combo.currentData(),
            "size": float(self.stamp_size_spin.value()),
            "line_width": float(self.stamp_line_spin.value()),
        }
        self._remember_annotation_defaults(
            "date_stamp",
            {
                key: value
                for key, value in settings.items()
                if key != "date"
            },
        )
        return settings

    def on_view_annotation_mode_changed(self, mode):
        action_map = {
            "hand": self.hand_action,
            "check": self.check_action,
            "comment": self.comment_action,
            "date_stamp": self.date_stamp_action,
            "arrow": self.arrow_action,
            "rectangle": self.rectangle_action,
            "ellipse": self.ellipse_action,
            "freehand": self.freehand_action,
