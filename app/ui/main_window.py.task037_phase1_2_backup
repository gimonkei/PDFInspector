    def update_display_size(self):
        max_width = int(
            self.panel.thumbnail_width
        )
        max_height = int(
            self.panel.thumbnail_height
        )

        if self._source_pixmap.isNull():
            shown = QPixmap(
                max_width,
                max_height,
            )
            shown.fill(
                self.palette().color(
                    self.backgroundRole()
                )
            )
        else:
            shown = self._source_pixmap.scaled(
                max_width,
                max_height,
                Qt.AspectRatioMode.KeepAspectRatio,
                Qt.TransformationMode.SmoothTransformation,
            )

        display_width = max(
            shown.width(),
            1,
        )
        display_height = max(
            shown.height(),
            1,
        )

        self.image_label.setMinimumSize(
            display_width,
            display_height,
        )
        self.image_label.setMaximumSize(
            display_width,
            display_height,
        )
        self.image_label.resize(
            display_width,
            display_height,
        )
        self.image_label.setPixmap(shown)

        number_height = max(
            self.number_label.sizeHint().height(),
            self.page_size_label.sizeHint().height(),
            22,
        )
        self.number_label.setFixedHeight(
            number_height
        )
        self.page_size_label.setMinimumHeight(
            number_height
        )
        self.page_size_label.setMaximumHeight(
            number_height
        )

        horizontal_margin = max(
            5,
            round(7 * self.panel.thumbnail_scale),
        )
        vertical_margin = max(
            4,
            round(7 * self.panel.thumbnail_scale),
        )
        spacing = max(
            2,
            round(4 * self.panel.thumbnail_scale),
        )

        self.card_layout.setContentsMargins(
            horizontal_margin,
            vertical_margin,
            horizontal_margin,
            max(3, vertical_margin - 2),
        )
        self.card_layout.setSpacing(spacing)

        card_width = (
            display_width
            + horizontal_margin * 2
            + 2
        )
        card_height = (
            display_height
            + number_height
            + vertical_margin
            + max(3, vertical_margin - 2)
            + spacing
            + 2
        )

        self.setMinimumSize(
            card_width,
            card_height,
        )
        self.setMaximumSize(
            card_width,
            card_height,
        )
        self.resize(
            card_width,
            card_height,
        )
        self.updateGeometry()
        self.card_layout.invalidate()
        self.update()


    def set_page_size_label(self, text):
