            has_pdf
            and self.current_page < self.document.page_count - 1
        )
        self.hand_action.setEnabled(has_pdf)
        self.check_action.setEnabled(has_pdf)
        self.comment_action.setEnabled(has_pdf)
        self.date_stamp_action.setEnabled(has_pdf)
        self.clear_selection_action.setEnabled(has_pdf)
        self.select_all_action.setEnabled(has_pdf)
        self.copy_action.setEnabled(has_pdf)
        self.paste_action.setEnabled(has_pdf)
        self.arrow_action.setEnabled(has_pdf)
        self.rectangle_action.setEnabled(has_pdf)
        self.ellipse_action.setEnabled(has_pdf)
        self.freehand_action.setEnabled(has_pdf)
        self.highlighter_action.setEnabled(has_pdf)
