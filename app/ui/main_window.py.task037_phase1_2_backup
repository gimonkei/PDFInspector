            "underline": (
                self.underline_check.isChecked()
            ),
            "border_enabled": (
                self.border_check.isChecked()
            ),
            "border_color": self._border_color.name(
                QColor.NameFormat.HexRgb
            ),
            "border_width": (
                self.border_width_spin.value()
            ),
            "border_padding_x": (
                self.border_padding_x_spin.value()
            ),
            "border_padding_y": (
                self.border_padding_y_spin.value()
            ),
        }


