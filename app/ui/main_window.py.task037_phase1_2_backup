            self.size_spin.valueChanged.connect(
                self._apply_numeric_change
            )

        if record_type in {"rectangle", "cloud", "ellipse"}:
            self.width_spin.valueChanged.connect(
                self._apply_numeric_change
            )
            self.height_spin.valueChanged.connect(
                self._apply_numeric_change
            )
            self.fill_check.toggled.connect(
                self._apply_numeric_change
            )
            self.opacity_spin.valueChanged.connect(
                self._apply_numeric_change
            )

        if record_type in {"rectangle", "cloud", "text"}:
            self.text_edit.textChanged.connect(
                self._schedule_text_apply
            )

        if record_type == "text":
            self.font_combo.currentFontChanged.connect(
                self._apply_numeric_change
            )
            self.font_size_spin.valueChanged.connect(
                self._apply_numeric_change
            )
            self.underline_check.toggled.connect(
                self._apply_numeric_change
            )
            self.border_check.toggled.connect(
                self._apply_numeric_change
            )
            self.border_width_spin.valueChanged.connect(
                self._apply_numeric_change
            )
            self.border_padding_x_spin.valueChanged.connect(
                self._apply_numeric_change
            )
            self.border_padding_y_spin.valueChanged.connect(
                self._apply_numeric_change
            )

        if record_type == "stamp":
            self.text_edit.textChanged.connect(self._schedule_text_apply)
            self.width_spin.valueChanged.connect(self._apply_numeric_change)
            self.height_spin.valueChanged.connect(self._apply_numeric_change)
            self.font_size_spin.valueChanged.connect(self._apply_numeric_change)
            self.line_width_spin.valueChanged.connect(self._apply_numeric_change)

        if record_type == "callout":
            self.text_edit.textChanged.connect(self._schedule_text_apply)
            self.line_width_spin.valueChanged.connect(self._apply_numeric_change)
            self.font_size_spin.valueChanged.connect(self._apply_numeric_change)
            self.width_spin.valueChanged.connect(self._apply_numeric_change)
            self.height_spin.valueChanged.connect(self._apply_numeric_change)
            self.opacity_spin.valueChanged.connect(self._apply_numeric_change)

        if record_type == "date_stamp":
            self.top_edit.textChanged.connect(
                self._schedule_text_apply
            )
            self.date_edit.textChanged.connect(
                self._schedule_text_apply
            )
            self.bottom_edit.textChanged.connect(
                self._schedule_text_apply
            )
            self.size_spin.valueChanged.connect(
                self._apply_numeric_change
            )
            self.line_width_spin.valueChanged.connect(
                self._apply_numeric_change
            )

    def _schedule_text_apply(self):
        if self._loading:
            return
        self._text_apply_timer.start()

    def _apply_numeric_change(self, *args):
        if self._loading:
            return
        self.apply_changes()

    def sync_geometry_from_record(self):
        if self._loading or self.item is None or not self.record:
            return

        record_type = str(self.record.get("type", ""))
        self._loading = True
        try:
            if record_type == "check" and hasattr(self, "size_spin"):
                value = float(self.record.get("size", 15.0))
                if abs(self.size_spin.value() - value) > 0.05:
                    self.size_spin.setValue(value)

            elif record_type in {"rectangle", "cloud", "ellipse"}:
                width = float(self.record.get("width", 80.0))
                height = float(self.record.get("height", 50.0))
                if abs(self.width_spin.value() - width) > 0.05:
                    self.width_spin.setValue(width)
                if abs(self.height_spin.value() - height) > 0.05:
                    self.height_spin.setValue(height)

            elif record_type == "date_stamp" and hasattr(self, "size_spin"):
                value = float(self.record.get("size", 72.0))
                if abs(self.size_spin.value() - value) > 0.05:
                    self.size_spin.setValue(value)
                    self.main_window._remember_annotation_defaults(
                        "date_stamp",
                        {
                            "top": str(
                                self.record.get("top", "検図")
                            ),
                            "bottom": str(
                                self.record.get("bottom", "松井")
                            ),
                            "color": self.record.get(
                                "color",
                                "black",
                            ),
                            "size": value,
                            "line_width": float(
                                self.record.get(
                                    "line_width",
                                    1.5,
                                )
                            ),
                        },
                    )
        finally:
            self._loading = False

    def _add_double(
        self,
        label,
        value,
        minimum,
        maximum,
        step,
        suffix,
    ):
        spin = QDoubleSpinBox(self)
        spin.setRange(float(minimum), float(maximum))
        spin.setSingleStep(float(step))
        spin.setDecimals(1)
        spin.setSuffix(suffix)
        spin.setValue(float(value))
        self.form_layout.addRow(f"{label}:", spin)
        return spin

    def _add_color(self, key, label, value):
        color = QColor(str(value))
        if not color.isValid():
            named = {
                "black": "#000000",
                "blue": "#0046dc",
                "red": "#dc0000",
            }
            color = QColor(named.get(str(value), "#dc0000"))

        self._color_values[key] = color
        button = QPushButton(self)
        button.clicked.connect(
            lambda checked=False, k=key, b=button:
                self._choose_color(k, b)
        )
        _set_color_button(button, color)
        self.form_layout.addRow(f"{label}:", button)

    def _choose_color(self, key, button):
        current = self._color_values.get(key, QColor("#dc0000"))
        selected = QColorDialog.getColor(
            current,
            self,
            "色を選択",
        )
        if not selected.isValid():
            return
        selected.setAlpha(255)
        self._color_values[key] = selected
        _set_color_button(button, selected)
        if not self._loading:
            self.apply_changes()

    def _color_name(self, key, fallback):
        color = self._color_values.get(key)
        if color is None or not color.isValid():
            return fallback
        return color.name(QColor.NameFormat.HexRgb)

    def apply_changes(self):
        if self._loading:
            return

        self._text_apply_timer.stop()
        item = self.item
        record = self.record
        if item is None or not record:
            return

        record_type = str(record.get("type", ""))
        view = self.main_window.view

        if record_type == "check":
            values = {
                "color": self._color_name("color", "#dc0000"),
                "size": self.size_spin.value(),
                "line_width": self.line_width_spin.value(),
            }
            view.update_check_properties(item, **values)
            self.main_window._remember_annotation_defaults(
                "check",
                values,
            )

        elif record_type == "arrow":
            values = {
                "color": self._color_name("color", "#dc0000"),
                "line_width": self.line_width_spin.value(),
            }
            view.update_arrow_properties(item, **values)
            self.main_window._remember_annotation_defaults("arrow", values)

        elif record_type == "freehand":
            values = {
                "color": self._color_name("color", "#dc0000"),
                "line_width": self.line_width_spin.value(),
            }
            view.update_freehand_properties(item, **values)
            self.main_window._remember_annotation_defaults("freehand", values)

        elif record_type in {"rectangle", "cloud", "ellipse"}:
            text = (
                self.text_edit.toPlainText()
                if record_type in {"rectangle", "cloud"}
                else ""
            )
            border_color = self._color_name(
                "border_color",
                "#dc0000",
            )
            values = {
                "color": border_color,
                "line_width": self.line_width_spin.value(),
                "fill_enabled": self.fill_check.isChecked(),
                "fill_opacity": self.opacity_spin.value() / 100.0,
                "fill_color": self._color_name(
                    "fill_color",
                    "#ffff00",
                ),
            }

            view.update_shape_properties(
                item,
                text,
                font_size=record.get("font_size", 11.0),
                fill_enabled=values["fill_enabled"],
                fill_opacity=values["fill_opacity"],
                fill_color=values["fill_color"],
                text_color=(
                    self._color_name("text_color", "#000000")
                    if record_type in {"rectangle", "cloud"}
                    else None
                ),
                border_color=border_color,
                line_width=values["line_width"],
                width=self.width_spin.value(),
                height=self.height_spin.value(),
            )

            if record_type in {"rectangle", "cloud"}:
                values["text_color"] = self._color_name(
                    "text_color",
                    "#000000",
                )
                values["font_size"] = record.get(
                    "font_size",
                    11.0,
                )

            self.main_window._remember_annotation_defaults(
                record_type,
                values,
            )

        elif record_type == "text":
            before = view._history_snapshot()

            values = {
                "text": (
                    self.text_edit.toPlainText().strip()
                ),
                "font_family": (
                    self.font_combo.currentFont().family()
                ),
                "font_size": (
                    self.font_size_spin.value()
                ),
                "text_color": self._color_name(
                    "text_color",
                    "#dc0000",
                ),
                "underline": (
                    self.underline_check.isChecked()
                ),
                "border_enabled": (
                    self.border_check.isChecked()
                ),
                "border_color": self._color_name(
                    "comment_border_color",
                    "#dc0000",
                ),
                "border_width": (
                    self.border_width_spin.value()
                ),
                "border_padding_x": (
                    self.border_padding_x_spin.value()
                ),
                "border_padding_y": (
                    self.border_padding_y_spin.value()
                ),
            }
            record.update(values)

            if hasattr(
                item,
                "refresh_from_record",
            ):
                item.refresh_from_record()
            else:
                item.setPlainText(
                    values["text"]
                )
                item.update()

            view._refresh_selection_overlay()
            view._commit_history_change(before)

            self.main_window._remember_annotation_defaults(
                "text",
                {
                    key: value
                    for key, value in values.items()
                    if key != "text"
                },
            )

        elif record_type == "stamp":
            before = view._history_snapshot()
            record["text"] = self.text_edit.toPlainText().strip()
            record["color"] = self._color_name("color", "#d00000")
            record["width"] = self.width_spin.value()
            record["height"] = self.height_spin.value()
            record["font_size"] = self.font_size_spin.value()
            record["line_width"] = self.line_width_spin.value()
            if hasattr(item, "refresh_from_record"):
                item.refresh_from_record()
            else:
                item.update()
            view._refresh_selection_overlay()
            view._commit_history_change(before)

        elif record_type == "callout":
            before = view._history_snapshot()
            record["text"] = self.text_edit.toPlainText().strip()
            record["color"] = self._color_name("border_color", "#d00000")
            record["arrow_color"] = self._color_name("arrow_color", record["color"])
            record["fill_color"] = self._color_name("fill_color", "#fff8c6")
            record["text_color"] = self._color_name("text_color", "#000000")
            record["line_width"] = self.line_width_spin.value()
            record["font_size"] = self.font_size_spin.value()
            record["width"] = self.width_spin.value()
            record["height"] = self.height_spin.value()
            record["fill_opacity"] = self.opacity_spin.value() / 100.0
            if hasattr(item, "refresh_from_record"):
                item.refresh_from_record()
            else:
                item.update()
            view._refresh_selection_overlay()
            view._commit_history_change(before)

        elif record_type == "date_stamp":
            before = view._history_snapshot()
            record["top"] = self.top_edit.text()
            record["date"] = self.date_edit.text()
            record["bottom"] = self.bottom_edit.text()
            record["color"] = self._color_name(
                "color",
                "#000000",
            )
            record["size"] = self.size_spin.value()
            record["line_width"] = self.line_width_spin.value()
            if hasattr(item, "refresh_from_record"):
                item.refresh_from_record()
            else:
                item.update()
            view._refresh_selection_overlay()
            view._commit_history_change(before)

            self.main_window._remember_annotation_defaults(
                "date_stamp",
                {
                    "top": record["top"],
                    "bottom": record["bottom"],
                    "color": record["color"],
                    "size": record["size"],
                    "line_width": record["line_width"],
                },
            )

        # Keep the current editor widgets in place. Rebuilding the panel
        # after every value change causes visible flicker and width movement.



class MultiAnnotationPropertiesPanel(QWidget):
