    def _get_annotation_defaults_path(self):
        config_dir = QStandardPaths.writableLocation(
            QStandardPaths.StandardLocation.AppConfigLocation
        )
        folder = Path(config_dir) / "PDFInspector"
        folder.mkdir(parents=True, exist_ok=True)
        return folder / "annotation_defaults.json"

    def _default_annotation_settings(self):
        return {
            "check": {
                "color": "#dc0000",
                "size": 15.0,
                "line_width": 2.2,
            },
            "arrow": {
                "color": "#dc0000",
