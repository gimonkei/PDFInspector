        if color.isValid():
            color.setAlpha(255)
            self._border_color = color
            _set_color_button(
                self.border_color_button,
                color,
            )

    def _accept_if_valid(self):
        if not self.text_edit.toPlainText().strip():
            QMessageBox.information(
                self,
                "コメント追加",
                "コメント内容を入力してください。",
            )
            self.text_edit.setFocus()
            return
        self.accept()

