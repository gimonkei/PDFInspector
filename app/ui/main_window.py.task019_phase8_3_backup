    def _load_annotation_defaults(self):
        defaults = self._default_annotation_settings()
        path = self._annotation_defaults_path
        if not path.exists():
            return defaults
        try:
            loaded = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError, TypeError):
            return defaults
        if not isinstance(loaded, dict):
            return defaults
        for annotation_type, values in loaded.items():
            if (
                annotation_type in defaults
                and isinstance(values, dict)
            ):
                defaults[annotation_type].update(values)
        return defaults

    def _save_annotation_defaults(self):
        try:
            self._annotation_defaults_path.write_text(
                json.dumps(
                    self._annotation_defaults,
                    ensure_ascii=False,
                    indent=2,
                ),
                encoding="utf-8",
            )
        except OSError:
            pass

    def _remember_annotation_defaults(
        self,
        annotation_type,
        values,
    ):
        if not isinstance(values, dict):
            return
        current = self._annotation_defaults.setdefault(
            str(annotation_type),
            {},
        )
        current.update(values)
        self.view.set_annotation_defaults(
            {annotation_type: current}
        )
        self._save_annotation_defaults()

