    def _template_file_path(self):
        base = Path(QStandardPaths.writableLocation(QStandardPaths.StandardLocation.AppConfigLocation))
        base.mkdir(parents=True, exist_ok=True)
        return base / "date_stamp_templates.json"

    def _load_date_stamp_templates(self):
        path = self._template_file_path()
        if not path.exists():
            return {}
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
            return data if isinstance(data, dict) else {}
        except (OSError, ValueError):
            return {}

    def _write_date_stamp_templates(self):
        path = self._template_file_path()
        path.write_text(
            json.dumps(self.date_stamp_templates, ensure_ascii=False, indent=2),
            encoding="utf-8",
        )

    def _refresh_template_combo(self, selected_name=None):
        combo = getattr(self, "stamp_template_combo", None)
        if combo is None:
            return
        combo.blockSignals(True)
        combo.clear()
        combo.addItem("新規作成", "")
        for name in sorted(self.date_stamp_templates):
            combo.addItem(name, name)
        if selected_name:
            index = combo.findData(selected_name)
            if index >= 0:
                combo.setCurrentIndex(index)
        combo.blockSignals(False)

    def on_date_stamp_template_selected(self, _index):
        name = self.stamp_template_combo.currentData()
        if not name:
            return
        settings = self.date_stamp_templates.get(name)
        if not settings:
            return
        widgets = [
            self.stamp_top_edit, self.stamp_bottom_edit, self.stamp_color_combo,
            self.stamp_size_spin, self.stamp_line_spin,
        ]
        for widget in widgets:
            widget.blockSignals(True)
        self.stamp_top_edit.setText(settings.get("top", ""))
        self.stamp_bottom_edit.setText(settings.get("bottom", ""))
        color_index = self.stamp_color_combo.findData(settings.get("color", "black"))
        self.stamp_color_combo.setCurrentIndex(max(0, color_index))
        self.stamp_size_spin.setValue(round(float(settings.get("size", 72.0))))
        self.stamp_line_spin.setValue(float(settings.get("line_width", 1.5)))
        self.stamp_date_edit.setText(date.today().strftime("'%y/%m/%d"))
        for widget in widgets:
            widget.blockSignals(False)
        self.update_selected_date_stamp()

    def save_date_stamp_template(self):
        current = self.stamp_template_combo.currentData()
        name, accepted = QInputDialog.getText(
            self, "テンプレート保存", "テンプレート名:", text=current or ""
        )
        name = name.strip()
        if not accepted or not name:
            return
        settings = self.current_date_stamp_settings()
        settings.pop("date", None)
        settings["use_today"] = True
        self.date_stamp_templates[name] = settings
        self._write_date_stamp_templates()
        self._refresh_template_combo(name)

    def delete_date_stamp_template(self):
        name = self.stamp_template_combo.currentData()
        if not name:
            return
        answer = QMessageBox.question(
            self, "テンプレート削除", f"「{name}」を削除しますか？"
        )
        if answer != QMessageBox.StandardButton.Yes:
            return
        self.date_stamp_templates.pop(name, None)
        self._write_date_stamp_templates()
        self._refresh_template_combo()

    def current_date_stamp_settings(self):
        today_text = date.today().strftime("'%y/%m/%d")
        self.stamp_date_edit.setText(today_text)
        return {
            "top": self.stamp_top_edit.text().strip(),
            "date": today_text,
            "bottom": self.stamp_bottom_edit.text().strip(),
            "color": self.stamp_color_combo.currentData(),
            "size": float(self.stamp_size_spin.value()),
            "line_width": float(self.stamp_line_spin.value()),
        }

    def set_annotation_mode(self, mode):
        self.view.set_annotation_mode(mode)


    def on_annotation_clicked(self, page_index, page_point):
        if not self.document.has_document():
            return

        mode = self.view.annotation_mode

        if mode == "check":
            self.view.add_check_overlay(page_index, page_point)
            return

        if mode == "comment":
            text, accepted = QInputDialog.getMultiLineText(
                self,
                "コメント追加",
                "コメント内容:",
            )
            if not accepted or not text.strip():
                return
            self.view.add_text_overlay(
                page_index,
                page_point,
                text,
            )
            return

        if mode == "date_stamp":
            self.view.add_date_stamp_overlay(
                page_index,
                page_point,
                self.current_date_stamp_settings(),
            )
            return


    def update_selected_date_stamp(self):
        item = self.selected_date_stamp_item
        if item is None or item.scene() is None:
            return
        self.view.update_annotation_record(
            item,
            {
                "top": self.stamp_top_edit.text().strip(),
                "date": self.stamp_date_edit.text().strip(),
                "bottom": self.stamp_bottom_edit.text().strip(),
                "color": self.stamp_color_combo.currentData(),
                "size": float(self.stamp_size_spin.value()),
                "line_width": float(self.stamp_line_spin.value()),
            },
            merge_property_edits=True,
        )


    def on_annotation_selected(self, item):
        if hasattr(self, "annotation_properties_panel"):
            if item is None:
                self.annotation_properties_panel.clear()
            else:
                self.annotation_properties_panel.set_item(item)
                self.annotation_properties_dock.show()
                self.annotation_properties_dock.raise_()

        if getattr(item, "record", {}).get("type") != "date_stamp":
            self.selected_date_stamp_item = None
            return

        self.selected_date_stamp_item = item
        record = item.record
        widgets = [
            self.stamp_top_edit,
            self.stamp_date_edit,
            self.stamp_bottom_edit,
            self.stamp_color_combo,
            self.stamp_size_spin,
            self.stamp_line_spin,
        ]
        for widget in widgets:
            widget.blockSignals(True)

        self.stamp_top_edit.setText(record.get("top", ""))
        self.stamp_date_edit.setText(record.get("date", ""))
        self.stamp_bottom_edit.setText(record.get("bottom", ""))
        color_index = self.stamp_color_combo.findData(
            record.get("color", "black")
        )
        self.stamp_color_combo.setCurrentIndex(
            max(0, color_index)
        )
        self.stamp_size_spin.setValue(
            round(float(record.get("size", 72.0)))
        )
        self.stamp_line_spin.setValue(
            float(record.get("line_width", 1.5))
        )

        for widget in widgets:
            widget.blockSignals(False)


    def on_annotation_edit_requested(self, item):
        record = getattr(item, "record", None)
        if not record:
            return

        record_type = record.get("type")

        if record_type == "text":
            text, accepted = QInputDialog.getMultiLineText(
                self,
                "コメント編集",
                "コメント内容:",
                record.get("text", ""),
            )
            if not accepted:
                return
            text = text.strip()
            if not text:
                before = self.view._history_snapshot()
                self.view._remove_record(record)
                self.view._commit_history_change(before)
                return
            before = self.view._history_snapshot()
            record["text"] = text
            item.setPlainText(text)
            self.view._commit_history_change(before)
            return

        if record_type == "date_stamp":
            self.on_annotation_selected(item)
            return

        if record_type == "arrow":
            dialog = LinePropertiesDialog(self, "矢印の編集", record)
            if dialog.exec() != QDialog.DialogCode.Accepted: return
            values = dialog.values()
            self.view.update_arrow_properties(
                item,
                color=values["color"],
                line_width=values["line_width"],
            )
            self._remember_annotation_defaults(
                "arrow",
                values,
            )
            return

        if record_type == "check":
            dialog = CheckPropertiesDialog(self, record)
            if dialog.exec() != QDialog.DialogCode.Accepted: return
            values = dialog.values()
            self.view.update_check_properties(
                item,
                color=values["color"],
                size=values["size"],
                line_width=values["line_width"],
            )
            self._remember_annotation_defaults(
                "check",
                values,
            )
            return

        if record_type in {"rectangle", "cloud"}:
            title = (
                "矩形の編集"
                if record_type == "rectangle"
                else "クラウドの編集"
            )
            dialog = ShapeContentDialog(self, title, record)
            if dialog.exec() != QDialog.DialogCode.Accepted:
                return

            values = dialog.values()
            self.view.update_shape_properties(
                item,
                values["text"],
                font_size=record.get("font_size", 11.0),
                fill_enabled=values["fill_enabled"],
                fill_opacity=values["fill_opacity"],
                fill_color=values["fill_color"],
                text_color=values["text_color"],
                border_color=values["border_color"],
                line_width=values["line_width"],
            )
            self._remember_annotation_defaults(
                record_type,
                {
                    "color": values["border_color"],
                    "line_width": values["line_width"],
                    "text_color": values["text_color"],
                    "fill_enabled": values["fill_enabled"],
                    "fill_opacity": values["fill_opacity"],
                    "fill_color": values["fill_color"],
                    "font_size": record.get("font_size", 11.0),
                },
            )


    def _commit_pending_annotations(self):
        annotations = self.view.export_annotations()
        if not annotations:
            return False

        for annotation in annotations:
            if annotation["type"] == "check":
                self.document.add_checkmark(
                    annotation["page_index"],
                    annotation["x"],
                    annotation["y"],
                    annotation.get("size", 15.0),
                    annotation.get("color", "#dc0000"),
                    annotation.get("line_width", 2.2),
                )
            elif annotation["type"] == "text":
                self.document.add_freetext_comment(
                    annotation["page_index"],
                    annotation["x"],
                    annotation["y"],
                    annotation["text"],
                    annotation.get("font_size", 11.0),
                )
            elif annotation["type"] == "date_stamp":
                self.document.add_date_stamp(
                    annotation["page_index"],
                    annotation["x"],
                    annotation["y"],
                    annotation.get("top", ""),
                    annotation.get("date", ""),
                    annotation.get("bottom", ""),
                    annotation.get("color", "black"),
                    annotation.get("size", 72.0),
                    annotation.get("line_width", 1.5),
                )
            elif annotation["type"] == "arrow":
                self.document.add_arrow(
                    annotation["page_index"],
                    annotation["x"],
                    annotation["y"],
                    annotation["x"] + annotation.get("dx", 80.0),
                    annotation["y"] + annotation.get("dy", 0.0),
                    annotation.get("color", "red"),
                    annotation.get("line_width", 2.0),
                )
            elif annotation["type"] in {"rectangle", "ellipse"}:
                self.document.add_shape(
                    annotation["type"],
                    annotation["page_index"],
                    annotation["x"],
                    annotation["y"],
                    annotation.get("width", 80.0),
                    annotation.get("height", 50.0),
                    annotation.get("color", "red"),
                    annotation.get("line_width", 2.0),
                    annotation.get("text", ""),
                    annotation.get("font_size", 11.0),
                    annotation.get("text_color", "#000000"),
                    annotation.get("fill_enabled", False),
                    annotation.get("fill_opacity", 0.25),
                    annotation.get("fill_color", "#ffff00"),
                )
            elif annotation["type"] == "cloud":
                self.document.add_cloud(
                    annotation["page_index"],
                    annotation["x"],
                    annotation["y"],
                    annotation.get("width", 80.0),
                    annotation.get("height", 50.0),
                    annotation.get("color", "red"),
                    annotation.get("line_width", 2.0),
                    annotation.get("cloud_radius", 8.0),
                    annotation.get("text", ""),
                    annotation.get("font_size", 11.0),
                    annotation.get("text_color", "#000000"),
                    annotation.get("fill_enabled", False),
                    annotation.get("fill_opacity", 0.25),
                    annotation.get("fill_color", "#ffff00"),
                )

        self.view.clear_pending_annotations()
        self.render_pipeline.invalidate()
        self.render_manager.clear()
        self.render_manager.prepare_document(self.document)
        self.view.clear_rendered_tiles()
        self.schedule_visible_tile_render()
        return True

    def update_toolbar(self):
        has_pdf = self.document.has_document()
        self.prev_action.setEnabled(
            has_pdf and self.current_page > 0
        )
        self.next_action.setEnabled(
            has_pdf
            and self.current_page < self.document.page_count - 1
        )
        self.hand_action.setEnabled(has_pdf)
        self.check_action.setEnabled(has_pdf)
        self.comment_action.setEnabled(has_pdf)
        self.date_stamp_action.setEnabled(has_pdf)
        self.clear_selection_action.setEnabled(has_pdf)
        self.select_all_action.setEnabled(has_pdf)
        self.copy_action.setEnabled(has_pdf)
        self.paste_action.setEnabled(has_pdf)
        self.arrow_action.setEnabled(has_pdf)
        self.rectangle_action.setEnabled(has_pdf)
        self.ellipse_action.setEnabled(has_pdf)
        self.cloud_action.setEnabled(has_pdf)
        if not has_pdf:
            self.undo_action.setEnabled(False)
            self.redo_action.setEnabled(False)
        self.page_label.setText(
            f"{self.current_page + 1} / {self.document.page_count}"
            if has_pdf
            else "0 / 0"
        )

    def _device_pixel_ratio(self):
        return max(float(self.view.devicePixelRatioF()), 1.0)

    def update_render_label(self):
        scale = self.render_manager.target_scale(
            self.view.zoom_factor,
            self._device_pixel_ratio(),
        )
        state = (
            "ON"
            if self.render_manager.hairline_enabled
            else "OFF"
        )
        cache_count = self.render_manager.tile_cache_count()
        busy = "描画中" if self.render_pipeline.is_busy else "待機"
        self.render_scale_label.setText(
            f" 描画: {scale:.2f}x / ASYNC "
            f"/ {busy} / 細線{state} / cache {cache_count} "
        )

    def show_document(self):
        layouts = self.render_manager.get_page_layouts(
            self.document
        )
        self.view.show_pages(layouts)
        self.view.scroll_to_page(self.current_page)
        self.update_toolbar()
        self.update_render_label()
        self.schedule_visible_tile_render()

    def schedule_visible_tile_render(self):
        if self.document.has_document():
            self.visible_tile_timer.start()

    def render_visible_tiles(self):
        if not self.document.has_document():
            return

        page_regions = self.view.visible_page_regions()
        if not page_regions:
            return

        request = self.render_pipeline.create_request(
            page_regions,
            self.view.zoom_factor,
            self._device_pixel_ratio(),
        )
        self.render_pipeline.submit(
            self.document,
            request,
        )
        self.update_render_label()

    def on_render_result(self, result):
        if not self.render_pipeline.is_current(result.generation):
            return
        self.view.apply_rendered_pages(result.pages)
        self.update_render_label()

    def on_render_failed(self, generation, details):
        if not self.render_pipeline.is_current(generation):
            return
        self.update_render_label()
        QMessageBox.warning(
            self,
            "PDF描画エラー",
            "PDFのバックグラウンド描画に失敗しました。\n\n"
            + details,
        )

    def on_render_busy_changed(self, _busy):
        self.update_render_label()

    def rerender_for_current_zoom(self):
        if not self.document.has_document():
            return
        # Keep the previous tiles visible while the new zoom level is rendered.
        # PDFView replaces each completed tile atomically, preventing a white
        # flash between invalidation and the asynchronous render result.
        self.render_pipeline.invalidate()
        self.update_render_label()
        self.schedule_visible_tile_render()

    def on_zoom_changed(self, zoom_factor):
        self.update_zoom_display(zoom_factor)
        self.update_render_label()
        if self.document.has_document():
            self.render_timer.start()

    def toggle_hairline(self, enabled):
        self.render_pipeline.invalidate()
        self.render_manager.set_hairline_enabled(enabled)
        if self.document.has_document():
            # Retain the current image until replacement tiles arrive.
            self.update_render_label()
            self.schedule_visible_tile_render()

    def open_pdf(self):
        path, _ = QFileDialog.getOpenFileName(
            self,
            "PDF選択",
            "",
            "PDF (*.pdf)",
        )
        if path:
            self.open_pdf_path(path)

    def open_pdf_path(self, path):
        path = str(Path(path))
        try:
            self.document.open(path)
            self.selected_date_stamp_item = None
            self.view.clear_pending_annotations()
            self.render_pipeline.invalidate()
            self.render_manager.clear()
            self.render_manager.prepare_document(self.document)
            self.current_page = 0
            self.show_document()
            self.view.fit_to_width()
            self.setWindowTitle(f"{Path(path).name} - PDFInspector")
            return True
        except PDFOpenError as error:
            QMessageBox.critical(
                self,
                "PDFを開けません",
                str(error),
            )
            return False

    @staticmethod
    def _dropped_local_paths(mime_data):
        paths = []
        if not mime_data.hasUrls():
            return paths
        for url in mime_data.urls():
            if not url.isLocalFile():
                continue
            local_path = Path(url.toLocalFile())
            if local_path.is_file():
                paths.append(local_path)
        return paths

    def dragEnterEvent(self, event):
        paths = self._dropped_local_paths(event.mimeData())
        if any(path.suffix.lower() == ".pdf" for path in paths):
            event.acceptProposedAction()
        else:
            event.ignore()

    def dragMoveEvent(self, event):
        paths = self._dropped_local_paths(event.mimeData())
        if any(path.suffix.lower() == ".pdf" for path in paths):
            event.acceptProposedAction()
        else:
            event.ignore()

    def dropEvent(self, event):
        paths = self._dropped_local_paths(event.mimeData())
        pdf_paths = [path for path in paths if path.suffix.lower() == ".pdf"]
        unsupported = [path for path in paths if path.suffix.lower() != ".pdf"]

        if not pdf_paths:
            QMessageBox.information(
                self,
                "ファイルを開けません",
                "PDFファイルをドロップしてください。",
            )
            event.ignore()
            return

        # The current application is still single-document. Open the first
        # dropped PDF now; Task020 multi-tab support will open every PDF in
        # its own tab without changing this drop interface.
        opened = self.open_pdf_path(pdf_paths[0])
        if opened:
            event.acceptProposedAction()

        messages = []
        if len(pdf_paths) > 1:
            messages.append(
                f"現在は1ファイル表示のため、先頭のPDFだけ開きました。"
                f"\n残り {len(pdf_paths) - 1} ファイルはマルチタブ対応時に開けるようになります。"
            )
        if unsupported:
            messages.append(
                f"PDF以外の {len(unsupported)} ファイルは開きませんでした。"
            )
        if messages:
            QMessageBox.information(
                self,
                "ドラッグ＆ドロップ",
                "\n\n".join(messages),
            )

    def next_page(self):
        if (
            not self.document.has_document()
            or self.current_page
            >= self.document.page_count - 1
        ):
            return
        self.current_page += 1
        self.view.scroll_to_page(self.current_page)
        self.update_toolbar()
        self.schedule_visible_tile_render()

    def prev_page(self):
        if (
            not self.document.has_document()
            or self.current_page <= 0
        ):
            return
        self.current_page -= 1
        self.view.scroll_to_page(self.current_page)
        self.update_toolbar()
        self.schedule_visible_tile_render()

    def update_current_page(self, page):
        if page != self.current_page:
            self.current_page = page
            self.update_toolbar()

    def change_zoom(self, index):
        self.apply_zoom_text(
            self.zoom_combo.itemText(index)
        )

    def apply_typed_zoom(self):
        self.apply_zoom_text(
            self.zoom_combo.currentText()
        )

    def apply_zoom_text(self, text):
        value = text.strip().replace("%", "")
        try:
            percent = float(value)
        except ValueError:
            self.update_zoom_display(self.view.zoom_factor)
            return
        percent = max(10.0, min(percent, 800.0))
        self.view.set_zoom(percent / 100.0)

    def update_zoom_display(self, zoom_factor):
        percent = round(zoom_factor * 100)
        self.zoom_combo.blockSignals(True)
        self.zoom_combo.setCurrentText(f"{percent}%")
        self.zoom_combo.blockSignals(False)

    def fit_to_width(self):
        if not self.document.has_document():
            return
        if not self.view.fit_to_width():
            QMessageBox.information(
                self,
                "幅に合わせる",
                "表示できるPDFページがありません。",
            )

    def save_pdf(self):
        if not self.document.has_document():
            return
        try:
            self._commit_pending_annotations()
            self.document.save()
        except PDFSaveError as error:
            QMessageBox.critical(
                self,
                "PDFを保存できません",
                str(error),
            )

    def save_as_pdf(self):
        if not self.document.has_document():
            return
        path, _ = QFileDialog.getSaveFileName(
            self,
            "名前を付けて保存",
            "",
            "PDF (*.pdf)",
        )
        if not path:
            return
        if not path.lower().endswith(".pdf"):
            path += ".pdf"
        try:
            self._commit_pending_annotations()
            self.document.save_as(path)
        except PDFSaveError as error:
            QMessageBox.critical(
                self,
                "PDFを保存できません",
                str(error),
            )

    def rotate_left(self):
        if not self.document.has_document():
            return
        if (
            QApplication.keyboardModifiers()
            & Qt.KeyboardModifier.ShiftModifier
        ):
            self.document.rotate_all_pages(-90)
        else:
            self.document.rotate_page(
                self.current_page,
                -90,
            )
        self.render_pipeline.invalidate()
        self.render_manager.clear()
        self.render_manager.prepare_document(self.document)
        self.show_document()
        self.view.fit_to_width()

    def rotate_right(self):
        if not self.document.has_document():
            return
        if (
            QApplication.keyboardModifiers()
            & Qt.KeyboardModifier.ShiftModifier
        ):
            self.document.rotate_all_pages(90)
        else:
            self.document.rotate_page(
                self.current_page,
                90,
            )
        self.render_pipeline.invalidate()
        self.render_manager.clear()
        self.render_manager.prepare_document(self.document)
        self.show_document()
        self.view.fit_to_width()

    def change_view_mode(self, index):
        if index == 0:
            self.view.set_single_mode()
        else:
            self.view.set_continuous_mode()
        if self.document.has_document():
            self.render_pipeline.invalidate()
            self.view.scroll_to_page(self.current_page)
            self.schedule_visible_tile_render()

    def closeEvent(self, event):
        self.render_timer.stop()
        self.visible_tile_timer.stop()
        self.render_pipeline.shutdown()
        self.document.close()
        event.accept()
