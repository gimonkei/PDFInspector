def _set_color_button(button, color):
    name = color.name(QColor.NameFormat.HexRgb)
    fg = "#000000" if color.lightness() > 145 else "#ffffff"
    button.setText(name.upper())
    button.setStyleSheet(f"QPushButton {{background-color: {name}; color: {fg}; padding: 5px 12px;}}")


class LinePropertiesDialog(QDialog):
    def __init__(self, parent, title, record):
        super().__init__(parent); self.setWindowTitle(title)
        layout=QVBoxLayout(self); form=QFormLayout()
        self._color=QColor(str(record.get("color", "#dc0000")))
        if not self._color.isValid(): self._color=QColor("#dc0000")
        self.color_button=QPushButton(self); self.color_button.clicked.connect(self._choose_color); _set_color_button(self.color_button,self._color); form.addRow("色:",self.color_button)
        self.line_width_spin=QDoubleSpinBox(self); self.line_width_spin.setRange(0.5,10.0); self.line_width_spin.setSingleStep(0.5); self.line_width_spin.setDecimals(1); self.line_width_spin.setSuffix(" pt"); self.line_width_spin.setValue(max(float(record.get("line_width",2.0)),0.5)); form.addRow("太さ:",self.line_width_spin)
        layout.addLayout(form)
        buttons=QDialogButtonBox(QDialogButtonBox.StandardButton.Ok|QDialogButtonBox.StandardButton.Cancel,parent=self); buttons.accepted.connect(self.accept); buttons.rejected.connect(self.reject); layout.addWidget(buttons)
    def _choose_color(self):
        c=QColorDialog.getColor(self._color,self,"色を選択")
        if c.isValid(): c.setAlpha(255); self._color=c; _set_color_button(self.color_button,c)
    def values(self): return {"color":self._color.name(QColor.NameFormat.HexRgb),"line_width":self.line_width_spin.value()}


class CheckPropertiesDialog(LinePropertiesDialog):
    def __init__(self,parent,record):
        super().__init__(parent,"チェックマークの編集",record)
        form=self.layout().itemAt(0).layout(); self.size_spin=QDoubleSpinBox(self); self.size_spin.setRange(6.0,200.0); self.size_spin.setSingleStep(1.0); self.size_spin.setDecimals(1); self.size_spin.setSuffix(" pt"); self.size_spin.setValue(max(float(record.get("size",15.0)),6.0)); form.addRow("サイズ:",self.size_spin)
    def values(self):
        v=super().values(); v["size"]=self.size_spin.value(); return v


class ShapeContentDialog(QDialog):
    def __init__(self, parent, title, record):
        super().__init__(parent)
        self.setWindowTitle(title)
        self.resize(420, 300)

        layout = QVBoxLayout(self)
        form = QFormLayout()

        self.text_edit = QTextEdit(self)
        self.text_edit.setPlainText(str(record.get("text", "")))
        self.text_edit.setPlaceholderText("図形内に表示する文字")
        form.addRow("文字:", self.text_edit)

        self._text_color = QColor(
            str(record.get("text_color", "#000000"))
        )
        if not self._text_color.isValid():
            self._text_color = QColor("#000000")

        self.text_color_button = QPushButton(self)
        self.text_color_button.clicked.connect(
            self._choose_text_color
        )
        self._update_text_color_button()
        form.addRow("文字色:", self.text_color_button)

        self._border_color = QColor(str(record.get("color", "#dc0000")))
        if not self._border_color.isValid(): self._border_color = QColor("#dc0000")
        self.border_color_button = QPushButton(self); self.border_color_button.clicked.connect(self._choose_border_color); _set_color_button(self.border_color_button,self._border_color); form.addRow("枠線色:",self.border_color_button)
        self.line_width_spin = QDoubleSpinBox(self); self.line_width_spin.setRange(0.5,10.0); self.line_width_spin.setSingleStep(0.5); self.line_width_spin.setDecimals(1); self.line_width_spin.setSuffix(" pt"); self.line_width_spin.setValue(max(float(record.get("line_width",2.0)),0.5)); form.addRow("枠線太さ:",self.line_width_spin)

        self.fill_combo = QComboBox(self)
        self.fill_combo.addItem("透明", False)
        self.fill_combo.addItem("塗りつぶし", True)
        self.fill_combo.setCurrentIndex(
            1 if bool(record.get("fill_enabled", False)) else 0
        )
        form.addRow("背景:", self.fill_combo)

        self._fill_color = QColor(
            str(record.get("fill_color", "#ffff00"))
        )
        if not self._fill_color.isValid():
            self._fill_color = QColor("#ffff00")

        self.fill_color_button = QPushButton(self)
        self.fill_color_button.clicked.connect(self._choose_fill_color)
        self._update_fill_color_button()
        form.addRow("塗りつぶし色:", self.fill_color_button)

        self.opacity_spin = QSpinBox(self)
        self.opacity_spin.setRange(5, 100)
        self.opacity_spin.setSuffix("%")
        self.opacity_spin.setValue(
            int(round(float(record.get("fill_opacity", 0.25)) * 100))
        )
        form.addRow("塗りつぶし濃度:", self.opacity_spin)

        self.fill_combo.currentIndexChanged.connect(
            self._update_fill_controls
        )
        self._update_fill_controls()
        layout.addLayout(form)

        buttons = QDialogButtonBox(
            QDialogButtonBox.StandardButton.Ok
            | QDialogButtonBox.StandardButton.Cancel,
            parent=self,
        )
        buttons.accepted.connect(self.accept)
        buttons.rejected.connect(self.reject)
        layout.addWidget(buttons)

    def _choose_text_color(self):
        selected = QColorDialog.getColor(
            self._text_color,
            self,
            "文字色を選択",
        )
        if not selected.isValid():
            return
        selected.setAlpha(255)
        self._text_color = selected
        self._update_text_color_button()

    def _update_text_color_button(self):
        color_name = self._text_color.name(
            QColor.NameFormat.HexRgb
        )
        text_color = (
            "#000000"
            if self._text_color.lightness() > 145
            else "#ffffff"
        )
        self.text_color_button.setText(color_name.upper())
        self.text_color_button.setStyleSheet(
            "QPushButton {"
            f"background-color: {color_name};"
            f"color: {text_color};"
            "padding: 5px 12px;"
            "}"
        )

    def _choose_border_color(self):
        c=QColorDialog.getColor(self._border_color,self,"枠線色を選択")
        if c.isValid(): c.setAlpha(255); self._border_color=c; _set_color_button(self.border_color_button,c)

    def _update_fill_controls(self):
        enabled = bool(self.fill_combo.currentData())
        self.fill_color_button.setEnabled(enabled)
        self.opacity_spin.setEnabled(enabled)

    def _choose_fill_color(self):
        selected = QColorDialog.getColor(
            self._fill_color,
            self,
            "塗りつぶし色を選択",
        )
        if not selected.isValid():
            return
        selected.setAlpha(255)
        self._fill_color = selected
        self._update_fill_color_button()

    def _update_fill_color_button(self):
        color_name = self._fill_color.name(QColor.NameFormat.HexRgb)
        text_color = (
            "#000000"
            if self._fill_color.lightness() > 145
            else "#ffffff"
        )
        self.fill_color_button.setText(color_name.upper())
        self.fill_color_button.setStyleSheet(
            "QPushButton {"
            f"background-color: {color_name};"
            f"color: {text_color};"
            "padding: 5px 12px;"
            "}"
        )

    def values(self):
        return {
            "text": self.text_edit.toPlainText().strip(),
            "text_color": self._text_color.name(
                QColor.NameFormat.HexRgb
            ),
            "border_color": self._border_color.name(QColor.NameFormat.HexRgb),
            "line_width": self.line_width_spin.value(),
            "fill_enabled": bool(self.fill_combo.currentData()),
            "fill_opacity": self.opacity_spin.value() / 100.0,
            "fill_color": self._fill_color.name(
                QColor.NameFormat.HexRgb
            ),
        }



class AnnotationPropertiesPanel(QWidget):
    """Right-side editor for the currently active annotation."""

    TYPE_NAMES = {
        "check": "チェックマーク",
        "text": "コメント",
        "date_stamp": "デート印",
        "arrow": "矢印",
        "rectangle": "矩形",
        "ellipse": "円・楕円",
        "cloud": "クラウド",
    }

    def __init__(self, main_window):
        super().__init__(main_window)
        self.main_window = main_window

        # Keep the property area at a fixed width so switching annotation
        # types does not make the dock jump or resize.
        self.setMinimumWidth(340)
        self.setMaximumWidth(340)
        self.item = None
        self.record = None
        self._loading = False
        self._color_values = {}

        self.root_layout = QVBoxLayout(self)
        self.title_label = QLabel("注釈を選択してください", self)
        self.title_label.setStyleSheet(
            "font-weight: bold; padding: 4px;"
        )
        self.root_layout.addWidget(self.title_label)

        self.form_widget = QWidget(self)
        self.form_layout = QFormLayout(self.form_widget)
        self.root_layout.addWidget(self.form_widget)

        self.apply_button = QPushButton("適用", self)
        self.apply_button.clicked.connect(self.apply_changes)
        self.apply_button.setEnabled(False)
        self.root_layout.addWidget(self.apply_button)
        self.root_layout.addStretch(1)

    def clear(self):
        self.item = None
        self.record = None
        self.title_label.setText("注釈を選択してください")
        self._clear_form()
        self.apply_button.setEnabled(False)

    def _clear_form(self):
        while self.form_layout.rowCount() > 0:
            self.form_layout.removeRow(0)
        self._color_values = {}

    def set_item(self, item):
        record = getattr(item, "record", None)
        if not record:
            self.clear()
            return

        self.item = item
        self.record = record
        self._loading = True
        self._clear_form()

        record_type = str(record.get("type", ""))
        self.title_label.setText(
            self.TYPE_NAMES.get(record_type, record_type)
        )

        self.type_label = QLabel(
            self.TYPE_NAMES.get(record_type, record_type),
            self,
        )
        self.form_layout.addRow("種類:", self.type_label)

        if record_type == "check":
            self._add_color("color", "色", record.get("color", "#dc0000"))
            self.size_spin = self._add_double(
                "サイズ",
                record.get("size", 15.0),
                6.0,
                200.0,
                1.0,
                " pt",
            )
            self.line_width_spin = self._add_double(
                "線幅",
                record.get("line_width", 2.2),
                0.5,
                10.0,
                0.5,
                " pt",
            )

        elif record_type == "arrow":
            self._add_color("color", "色", record.get("color", "#dc0000"))
            self.line_width_spin = self._add_double(
                "太さ",
                record.get("line_width", 2.0),
                0.5,
                10.0,
                0.5,
                " pt",
            )

        elif record_type in {"rectangle", "cloud"}:
            self.text_edit = QTextEdit(self)
            self.text_edit.setMaximumHeight(110)
            self.text_edit.setPlainText(str(record.get("text", "")))
            self.form_layout.addRow("文字:", self.text_edit)

            self._add_color(
                "text_color",
                "文字色",
                record.get("text_color", "#000000"),
            )
            self._add_color(
                "border_color",
                "枠線色",
                record.get("color", "#dc0000"),
            )
            self.line_width_spin = self._add_double(
                "枠線太さ",
                record.get("line_width", 2.0),
                0.5,
                10.0,
                0.5,
                " pt",
            )

            self.fill_check = QCheckBox("塗りつぶす", self)
            self.fill_check.setChecked(
                bool(record.get("fill_enabled", False))
            )
            self.form_layout.addRow("背景:", self.fill_check)

            self._add_color(
                "fill_color",
                "塗りつぶし色",
                record.get("fill_color", "#ffff00"),
            )
            self.opacity_spin = self._add_double(
                "濃度",
                float(record.get("fill_opacity", 0.25)) * 100.0,
                0.0,
                100.0,
                5.0,
                " %",
            )

        elif record_type == "ellipse":
            self._add_color(
                "border_color",
                "枠線色",
                record.get("color", "#dc0000"),
            )
            self.line_width_spin = self._add_double(
                "枠線太さ",
                record.get("line_width", 2.0),
                0.5,
                10.0,
                0.5,
                " pt",
            )

            self.fill_check = QCheckBox("塗りつぶす", self)
            self.fill_check.setChecked(
                bool(record.get("fill_enabled", False))
            )
            self.form_layout.addRow("背景:", self.fill_check)

            self._add_color(
                "fill_color",
                "塗りつぶし色",
                record.get("fill_color", "#ffff00"),
            )
            self.opacity_spin = self._add_double(
                "濃度",
                float(record.get("fill_opacity", 0.25)) * 100.0,
                0.0,
                100.0,
                5.0,
                " %",
            )

        elif record_type == "text":
            self.text_edit = QTextEdit(self)
            self.text_edit.setMaximumHeight(140)
            self.text_edit.setPlainText(str(record.get("text", "")))
            self.form_layout.addRow("コメント:", self.text_edit)

        elif record_type == "date_stamp":
            self.top_edit = QLineEdit(
                str(record.get("top", "")),
                self,
            )
            self.date_edit = QLineEdit(
                str(record.get("date", "")),
                self,
            )
            self.bottom_edit = QLineEdit(
                str(record.get("bottom", "")),
                self,
            )
            self.form_layout.addRow("上段:", self.top_edit)
            self.form_layout.addRow("日付:", self.date_edit)
            self.form_layout.addRow("下段:", self.bottom_edit)
            self._add_color(
                "color",
                "色",
                record.get("color", "black"),
            )
            self.size_spin = self._add_double(
                "サイズ",
                record.get("size", 72.0),
                20.0,
                240.0,
                2.0,
                " pt",
            )
            self.line_width_spin = self._add_double(
                "線幅",
                record.get("line_width", 1.5),
                0.5,
                10.0,
                0.5,
                " pt",
            )

        else:
            self.form_layout.addRow(
                QLabel("この注釈は現在表示のみ対応しています。", self)
            )

        self.apply_button.setEnabled(True)
        self._loading = False

    def _add_double(
        self,
        label,
        value,
        minimum,
        maximum,
        step,
        suffix,
    ):
        spin = QDoubleSpinBox(self)
        spin.setRange(float(minimum), float(maximum))
        spin.setSingleStep(float(step))
        spin.setDecimals(1)
        spin.setSuffix(suffix)
        spin.setValue(float(value))
        self.form_layout.addRow(f"{label}:", spin)
        return spin

    def _add_color(self, key, label, value):
        color = QColor(str(value))
        if not color.isValid():
            named = {
                "black": "#000000",
                "blue": "#0046dc",
                "red": "#dc0000",
            }
            color = QColor(named.get(str(value), "#dc0000"))

        self._color_values[key] = color
        button = QPushButton(self)
        button.clicked.connect(
            lambda checked=False, k=key, b=button:
                self._choose_color(k, b)
        )
        _set_color_button(button, color)
        self.form_layout.addRow(f"{label}:", button)

    def _choose_color(self, key, button):
        current = self._color_values.get(key, QColor("#dc0000"))
        selected = QColorDialog.getColor(
            current,
            self,
            "色を選択",
        )
        if not selected.isValid():
            return
        selected.setAlpha(255)
        self._color_values[key] = selected
        _set_color_button(button, selected)

    def _color_name(self, key, fallback):
        color = self._color_values.get(key)
        if color is None or not color.isValid():
            return fallback
        return color.name(QColor.NameFormat.HexRgb)

    def apply_changes(self):
        item = self.item
        record = self.record
        if item is None or not record:
            return

        record_type = str(record.get("type", ""))
        view = self.main_window.view

        if record_type == "check":
            values = {
                "color": self._color_name("color", "#dc0000"),
                "size": self.size_spin.value(),
                "line_width": self.line_width_spin.value(),
            }
            view.update_check_properties(item, **values)
            self.main_window._remember_annotation_defaults(
                "check",
                values,
            )

        elif record_type == "arrow":
            values = {
                "color": self._color_name("color", "#dc0000"),
                "line_width": self.line_width_spin.value(),
            }
            view.update_arrow_properties(item, **values)
            self.main_window._remember_annotation_defaults(
                "arrow",
                values,
            )

        elif record_type in {"rectangle", "cloud", "ellipse"}:
            text = (
                self.text_edit.toPlainText()
                if record_type in {"rectangle", "cloud"}
                else ""
            )
            border_color = self._color_name(
                "border_color",
                "#dc0000",
            )
            values = {
                "color": border_color,
                "line_width": self.line_width_spin.value(),
                "fill_enabled": self.fill_check.isChecked(),
                "fill_opacity": self.opacity_spin.value() / 100.0,
                "fill_color": self._color_name(
                    "fill_color",
                    "#ffff00",
                ),
            }

            view.update_shape_properties(
                item,
                text,
                font_size=record.get("font_size", 11.0),
                fill_enabled=values["fill_enabled"],
                fill_opacity=values["fill_opacity"],
                fill_color=values["fill_color"],
                text_color=(
                    self._color_name("text_color", "#000000")
                    if record_type in {"rectangle", "cloud"}
                    else None
                ),
                border_color=border_color,
                line_width=values["line_width"],
            )

            if record_type in {"rectangle", "cloud"}:
                values["text_color"] = self._color_name(
                    "text_color",
                    "#000000",
                )
                values["font_size"] = record.get(
                    "font_size",
                    11.0,
                )

            self.main_window._remember_annotation_defaults(
                record_type,
                values,
            )

        elif record_type == "text":
            text = self.text_edit.toPlainText().strip()
            if not text:
                return
            before = view._history_snapshot()
            record["text"] = text
            item.setPlainText(text)
            view._commit_history_change(before)

        elif record_type == "date_stamp":
            before = view._history_snapshot()
            record["top"] = self.top_edit.text()
            record["date"] = self.date_edit.text()
            record["bottom"] = self.bottom_edit.text()
            record["color"] = self._color_name(
                "color",
                "#000000",
            )
            record["size"] = self.size_spin.value()
            record["line_width"] = self.line_width_spin.value()
            if hasattr(item, "refresh_from_record"):
                item.refresh_from_record()
            else:
                item.update()
            view._refresh_selection_overlay()
            view._commit_history_change(before)

        self.set_item(item)



class MainWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("PDFInspector")
        self.resize(1200, 800)
        self.setAcceptDrops(True)

        self.document = PDFDocument()
        self.renderer = PDFRenderer()
        self.render_manager = RenderManager(self.renderer)
        self.render_pipeline = RenderPipeline(self.render_manager, self)
        self.render_pipeline.result_ready.connect(
            self.on_render_result
        )
        self.render_pipeline.render_failed.connect(
            self.on_render_failed
        )
        self.render_pipeline.busy_changed.connect(
            self.on_render_busy_changed
        )
        self.current_page = 0

        self.view = PDFView()
        self._annotation_defaults_path = (
            self._get_annotation_defaults_path()
        )
        self._annotation_defaults = (
            self._load_annotation_defaults()
        )
        self.view.set_annotation_defaults(
            self._annotation_defaults
        )
        self.view.page_changed.connect(self.update_current_page)
        self.view.zoom_changed.connect(self.on_zoom_changed)
        self.view.visible_region_changed.connect(
            self.schedule_visible_tile_render
        )
        self.view.annotation_clicked.connect(self.on_annotation_clicked)
        self.view.annotation_edit_requested.connect(self.on_annotation_edit_requested)
        self.view.annotation_selected.connect(self.on_annotation_selected)
        self.view.undo_available_changed.connect(self.on_undo_available_changed)
        self.view.redo_available_changed.connect(
            self.on_redo_available_changed
        )
        self.view.selection_count_changed.connect(
            self.on_selection_count_changed
        )
        self.setCentralWidget(self.view)

        # Wait until zooming settles before switching render resolution.
        self.render_timer = QTimer(self)
        self.render_timer.setSingleShot(True)
        self.render_timer.setInterval(180)
        self.render_timer.timeout.connect(self.rerender_for_current_zoom)

        # Scrolling receives a shorter debounce and renders only nearby tiles.
        self.visible_tile_timer = QTimer(self)
        self.visible_tile_timer.setSingleShot(True)
        self.visible_tile_timer.setInterval(55)
        self.visible_tile_timer.timeout.connect(self.render_visible_tiles)

        self.create_toolbar()
        self.create_date_stamp_panel()
        self.create_annotation_properties_panel()

    def _get_annotation_defaults_path(self):
        config_dir = QStandardPaths.writableLocation(
            QStandardPaths.StandardLocation.AppConfigLocation
        )
        folder = Path(config_dir) / "PDFInspector"
        folder.mkdir(parents=True, exist_ok=True)
        return folder / "annotation_defaults.json"

    def _default_annotation_settings(self):
        return {
            "check": {
                "color": "#dc0000",
                "size": 15.0,
                "line_width": 2.2,
            },
            "arrow": {
                "color": "#dc0000",
                "line_width": 2.0,
            },
            "rectangle": {
                "color": "#dc0000",
                "line_width": 2.0,
                "text_color": "#000000",
                "fill_enabled": False,
                "fill_opacity": 0.25,
                "fill_color": "#ffff00",
                "font_size": 11.0,
            },
            "ellipse": {
                "color": "#dc0000",
                "line_width": 2.0,
                "fill_enabled": False,
                "fill_opacity": 0.25,
