    def on_selection_count_changed(self, count):
        count = int(count)

        if count <= 0:
            self.statusBar().clearMessage()
            if hasattr(self, "annotation_properties_panel"):
                self.annotation_properties_panel.clear()
            return

        if count == 1:
            self.statusBar().showMessage(
